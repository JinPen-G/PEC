[Unit]
Description=Preview native platform
After=network.target preview-recovery.service
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=|/opt/preview/releases/current.json
ConditionPathExists=|/opt/preview/state/transaction.json

[Service]
Type=simple
User=preview
Group=preview
WorkingDirectory=/opt/preview
ExecStart=@NODE@ /opt/preview/scripts/supervisor.mjs --config /etc/preview/deploy.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/preview/data /opt/preview/state

[Install]
WantedBy=multi-user.target
