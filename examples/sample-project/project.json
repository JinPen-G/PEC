      "description": "閱讀示例 PRD。",
      "icon": "Document",
      "order": 20
    }
  ],
  "docs": { "enabled": true, "root": "docs" },
  "prototype": {
    "enabled": true,
    "clients": {
      "admin": {
        "root": "prototype/admin",
        "section": "workspace",
        "icon": "Document",
        "shellMode": "auto"
      }
    }
  },
