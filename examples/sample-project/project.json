  "version": "0.1.0",
  "defaultLocale": "zh-CN",
  "pageDefinitions": "page-definitions.js",
  "homepage": { "visible": true },
  "branding": {},
  "theme": {
    "primary": "#007aff",
    "primaryHover": "#006ee6",
    "primaryActive": "#005fcc",
    "pageBackground": "#f5f7fb"
  },
  "clients": [
    {
      "id": "admin",
      "name": "管理端",
