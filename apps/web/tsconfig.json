{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@preview/library/*": ["../../packages/component-library/src/*"],
      "@preview/ui/admin": ["../../packages/preview-ui/src/admin.tsx"],
      "@preview/ui/loading": ["../../packages/preview-ui/src/LoadingState.tsx"],
      "@preview/ui/result": ["../../packages/preview-ui/src/ResultPage.tsx"],
      "@preview/ui/rest-player": ["../../packages/preview-ui/src/rest-player.ts"],
      "@/registry/*": [
        "../../packages/preview-ui/upstream/rental-admin/packages/ui-primitives/vendor/registry/*"
      ],
      "@preview/ui": ["../../packages/preview-ui/src/index.ts"],
      "@/registry/components/button/button": [
        "../../packages/preview-ui/upstream/rental-admin/packages/ui-primitives/vendor/registry/components/button/button.tsx"
      ],
      "@/lib/motion-tokens": [
        "../../packages/preview-ui/upstream/rental-admin/packages/ui-primitives/vendor/lib/motion-tokens.ts"
      ],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  "exclude": ["src/project-modules/rimo-rental", "src/features/orders", "src/**/*.local.*"]
}
